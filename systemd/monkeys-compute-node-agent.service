[Unit]
Description=Monkeys Kernel Runtime Node Agent
Documentation=https://github.com/inf-monkeys/monkeys-compute-node-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=MONKEYS_AGENT_MODE=host
Environment=MONKEYS_AGENT_INTERVAL=30s
Environment=MONKEYS_ALLOW_INSTALL=false
Environment=MONKEYS_DRY_RUN=true
EnvironmentFile=-/etc/monkeys-compute-node-agent/agent.env
ExecStart=/usr/local/bin/monkeys-compute-node-agent run --mode ${MONKEYS_AGENT_MODE} --server ${MONKEYS_SERVER} --state /var/lib/monkeys-compute-node-agent/agent-state.json --workspace /var/lib/monkeys-compute-node-agent/workspace --interval ${MONKEYS_AGENT_INTERVAL} --allow-install=${MONKEYS_ALLOW_INSTALL} --dry-run=${MONKEYS_DRY_RUN}
Restart=always
RestartSec=5
User=root
WorkingDirectory=/var/lib/monkeys-compute-node-agent
StateDirectory=monkeys-compute-node-agent
RuntimeDirectory=monkeys-compute-node-agent
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
